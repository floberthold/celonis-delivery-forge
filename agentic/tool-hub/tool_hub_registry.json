{
  "schema_version": 1,
  "description": "Central tool registry for one-click local startup across main repo and submodules.",
  "tools": [
    {
      "id": "foundry-api",
      "display_name": "Foundry API",
      "domain": "core-platform",
      "repo_path": ".",
      "enabled": true,
      "shell": "powershell",
      "command": "$env:PYTHONPATH='src'; python -m uvicorn foundry.api.main:app --reload --host 127.0.0.1 --port 8000",
      "install_editable": true,
      "health_probe": {
        "type": "http",
        "url": "http://127.0.0.1:8000/health"
      },
      "notes": "Primary local API runtime."
    },
    {
      "id": "agentic-code-analysis-mcp",
      "display_name": "Agentic Code Analysis MCP",
      "domain": "quality-automation",
      "repo_path": ".",
      "enabled": true,
      "shell": "powershell",
      "command": "python -m foundry.mcp.agentic_code_analysis run",
      "install_editable": true,
      "activation_phase": 1,
      "health_probe": {
        "type": "process"
      },
      "notes": "Recomputes codebase metrics, refreshes report values, and emits an LLM next-improvements prompt."
    },
    {
